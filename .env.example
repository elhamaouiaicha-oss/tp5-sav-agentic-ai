# Copiez ce fichier en `.env` (jamais versionné) et renseignez vos valeurs.

# --- LLM (format fournisseur:modèle) -----------------------------------------
OPENAI_API_KEY=
LLM_MODEL=openai:gpt-4o-mini
# Exemple local : LLM_MODEL=ollama:qwen2.5:7b   (pip install ".[ollama]")
# Test hors-ligne sans clé : LLM_MODEL=fake      (LLM factice, voir src/sav/fake_llm.py)

# --- Plongements --------------------------------------------------------------
# clip = CLIP multilingue (pip install ".[clip]") ; hash = tests hors-ligne uniquement
EMBEDDINGS_BACKEND=clip

# --- Serveur MCP --------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=23000
MCP_URL=http://localhost:23000/mcp
